# ==============================================================================
# GOTTI ECOSYSTEM — UNIFIED ENVIRONMENT CONFIGURATION
# Shared across all 4 projects:
#   1. gotti-backend   (Dual-Engine Fund Accounting, Risk Engine, API)
#   2. stock-alchemist (News Ingestion, Evaluations & Signal Generator)
#   3. gotti-visualize (Trading Execution & Visualization Engine)
#   4. gotti-frontend  (Next.js Client UI & Portfolios Dashboard)
# ==============================================================================

# ==============================================================================
# 1. DATABASE (MySQL Shared 'gotti' Schema)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=gotti
DB_DATABASE=gotti

# ==============================================================================
# 2. MODULE 4: DUAL-ENGINE 5 ALPACA PAPER ACCOUNTS ($1M Seed Each)
# ==============================================================================
# Level 1: Boomer Haven ETF
ALPACA_KEY_LVL1=
ALPACA_SECRET_LVL1=

# Level 2: Sleep-Tight ETF
ALPACA_KEY_LVL2=
ALPACA_SECRET_LVL2=

# Level 3: Steady Grind ETF
ALPACA_KEY_LVL3=
ALPACA_SECRET_LVL3=

# Level 4: Apex Hunter ETF
ALPACA_KEY_LVL4=
ALPACA_SECRET_LVL4=

# Level 5: Diamond Hands ETF
ALPACA_KEY_LVL5=
ALPACA_SECRET_LVL5=

# ==============================================================================
# 3. STOCK ALCHEMIST: MARKET DATA, NEWS & AI VALUATION
# ==============================================================================
# Alpaca Live News Stream (Paper / Live account key for WebSocket feed)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Google Gemini API Key (News sentiment & fundamental valuation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# MarketAux API (Financial news feed)
MARKETAUX_API_TOKEN=

# Refinitiv / LSEG Bridge
LSEG_ENABLED=true
LSEG_BRIDGE_URL=http://127.0.0.1:5000/api/v1
LSEG_BRIDGE_TIMEOUT=10

# ==============================================================================
# 4. TELEGRAM ALERT NOTIFICATIONS
# ==============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_SIGNALS_BOT_TOKEN=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_ERRORS_BOT_TOKEN=
TELEGRAM_ERRORS_CHAT_ID=

# ==============================================================================
# 5. NETWORKING, PORTS & WEBSOCKET BRIDGES
# ==============================================================================
# gotti-backend REST API
PORT=10000
BACKEND_PORT=10000

# gotti-backend -> gotti-visualize Trade Publisher WebSocket Server
TRADE_WS_PORT=8001

# stock-alchemist -> gotti-backend Signal Listener WebSocket Client
SA_WS_URL=ws://localhost:8080/ws/signals

# stock-alchemist Healthcheck / API Port
HEALTHCHECK_PORT=8080

# gotti-frontend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:10000/api

# Shared Inter-Service Secret
API_SECRET=

# ==============================================================================
# 6. DUAL-ENGINE SIMULATION PARAMETERS
# ==============================================================================
NAV_SYNC_INTERVAL=300
DEFAULT_ANNUAL_FEE=0.015
