# ==============================================================================
# Gotti Ecosystem — Shared Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# This single .env is shared by ALL services in docker-compose.yml:
#   - mysql           (MySQL container)
#   - stock-alchemist (analysis engine)
#   - gotti-api       (visualize FastAPI)
# ==============================================================================

# === Database (shared local MySQL) ============================================
DB_HOST=localhost          # overridden to "mysql" automatically inside Docker
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here
DB_DATABASE=gotti

# === Gemini API (news sentiment analysis — only cloud dependency) =============
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === Alpaca (news feed — free paper trading account) ==========================
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret

# === MarketAux (free tier is sufficient) ======================================
MARKETAUX_API_TOKEN=your_marketaux_token

# === Telegram Notifications (optional) =======================================
TELEGRAM_ENABLED=false
TELEGRAM_SIGNALS_BOT_TOKEN=
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_ERRORS_BOT_TOKEN=
TELEGRAM_ERRORS_CHAT_ID=

# === Stock Alchemist App ======================================================
API_SECRET=your_api_secret_here
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PORT=8080

# === Cloudflare Tunnel (optional — remove if not using) ======================
# CLOUDFLARE_TUNNEL_TOKEN=your_token_here
